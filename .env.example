# Gtrack environment variables
# Copy to .env and fill in. Never commit the real .env — it holds credentials.
# Load it with:  set -a; source .env; set +a      (macOS/Linux)
#                or set the variables in Render's dashboard (production)

# --- Database -------------------------------------------------------------
# Leave BLANK for local testing: Gtrack then uses instance/gtrack.db (SQLite).
# For Neon, paste the pooled connection string from the Neon dashboard.
# Gtrack adds sslmode=require automatically if you omit it.
GTRACK_DATABASE_URL=

# --- Security -------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
GTRACK_SECRET_KEY=

# --- Application ----------------------------------------------------------
GTRACK_ORG_NAME=Scientific Gate Egypt
GTRACK_UPLOAD_FOLDER=
GTRACK_NOTIFICATIONS_LIVE=0
